# =============================================================================
# LMS Academy WebApp — Environment Variables
# Copy this file to .env (development) or .env.production (production build)
#   cp .env.example .env
#   cp .env.example .env.production
# =============================================================================

# Backend URL used by the Vite dev-server proxy (npm run dev only).
# Production builds use relative /api paths — configure Nginx to proxy them.
VITE_PROXY_TARGET=http://43.205.127.39:8000

# Optional: override the frontend port when running vite preview under PM2
PORT=3000
